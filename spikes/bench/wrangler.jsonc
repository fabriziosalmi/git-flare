{
  "name": "gf-bench",
  "main": "index.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "rules": [{ "type": "CompiledWasm", "globs": ["**/*.wasm"], "fallthrough": false }],
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RepoCoordinator", "RepoRegistry"] }],
  "durable_objects": { "bindings": [{ "name": "REPO_COORDINATOR", "class_name": "RepoCoordinator" }, { "name": "REPO_REGISTRY", "class_name": "RepoRegistry" }] },
  "vars": { "ARTIFACTS_MODE": "mock", "QUEUE_BATCH_WINDOW_MS": "600000" }
}
